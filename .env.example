# ============================================================
# Frontend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# API Base URL (proxied via Vite dev server to backend)
VITE_API_URL=http://localhost:5173/api

# Production API URL (uncomment for production builds)
# VITE_API_URL=https://backend.proveownership.com/api

# Paystack Public Key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxx


# Got it — leave FRONTEND_URL=https://dev.proveownership.com for now. Enter these in the Paystack dashboard:
# - Webhook: https://backend.proveownership.com/api/payments/webhook/paystack
# - Callback: https://dev.proveownership.com/payment/callback
# When you switch to the main domain later, just update 
